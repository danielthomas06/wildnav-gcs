# Downloaded model weights — regenerated by install.sh, not source
pretrained/

# Flight run artifacts, not source
Logs/
server/webui_logs/

# Manual backup snapshot — redundant once git is the history mechanism
backup/

# Runtime-generated
server/uploads/
__pycache__/
*.pyc

# Secrets — cloud_relay.env should only ever exist on the Jetson itself,
# never in a synced/pushed tree. Keep .env.example (template, no secrets).
*.env
!*.env.example

# OS/editor cruft
.DS_Store
